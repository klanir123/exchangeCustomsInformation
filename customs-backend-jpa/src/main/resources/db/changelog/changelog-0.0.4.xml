<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:pro="http://www.liquibase.org/xml/ns/pro"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd
      http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.5.xsd">

	<!-- Supplier Tabelle -->
	<changeSet id="createSupplierTable" author="klanir123">
		<createTable tableName="supplier">
			<column name="bpnl" type="varchar(16)">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="name" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="street" type="varchar(255)"/>
			<column name="postal_code" type="varchar(20)"/>
			<column name="city" type="varchar(255)"/>
			<column name="country" type="varchar(2)"/>
			<column name="status" type="varchar(20)">
				<constraints nullable="false"/>
			</column>
			<column name="created_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
				<constraints nullable="false"/>
			</column>
			<column name="updated_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
				<constraints nullable="false"/>
			</column>
		</createTable>
	</changeSet>

	<!-- Supplier Contact Tabelle -->
	<changeSet id="createSupplierContactTable" author="klanir123">
		<createTable tableName="supplier_contact">
			<column name="id" type="bigint" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="supplier_bpnl" type="varchar(16)">
				<constraints nullable="false"/>
			</column>
			<column name="contact_person" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="phone_number" type="varchar(50)"/>
			<column name="email" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="job_title" type="varchar(255)"/>
			<column name="is_primary" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
			<column name="preferred_for_notifications" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
		</createTable>

		<addForeignKeyConstraint
			baseTableName="supplier_contact"
			baseColumnNames="supplier_bpnl"
			constraintName="fk_supplier_contact_supplier"
			referencedTableName="supplier"
			referencedColumnNames="bpnl"
			onDelete="CASCADE"/>
	</changeSet>

	<!-- Index für BPNL-Suche -->
	<changeSet id="createSupplierIndexes" author="klanir123">
		<createIndex indexName="idx_supplier_name" tableName="supplier">
			<column name="name"/>
		</createIndex>
		<createIndex indexName="idx_supplier_status" tableName="supplier">
			<column name="status"/>
		</createIndex>
		<createIndex indexName="idx_supplier_contact_bpnl" tableName="supplier_contact">
			<column name="supplier_bpnl"/>
		</createIndex>
	</changeSet>

</databaseChangeLog>
